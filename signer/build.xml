<?xml version="1.0" encoding="UTF-8"?>
<project name="burner-wallet-signer" default="build" basedir=".">
    <description>
        Burner Wallet Signer - Java ME MIDlet for Nokia C1-01.
        Requires JDK 8 (via jenv) and ProGuard in ../tools/proguard/.
    </description>

    <!-- Paths -->
    <property name="src.dir" value="src"/>
    <property name="res.dir" value="res"/>
    <property name="lib.dir" value="lib"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="proguard.home" value="${basedir}/../tools/proguard"/>

    <!-- Test paths -->
    <property name="test.src.dir" value="test"/>
    <property name="test.classes.dir" value="${build.dir}/test-classes"/>
    <property name="junit.jar" value="${lib.dir}/junit-4.13.2.jar"/>
    <property name="hamcrest.jar" value="${lib.dir}/hamcrest-core-1.3.jar"/>
    <property name="bc.jar" value="${lib.dir}/bcprov-jdk14.jar"/>

    <!-- MIDP/CLDC stub JARs for bootclasspath -->
    <property name="midp.jar" value="${lib.dir}/midpapi20.jar"/>
    <property name="cldc.jar" value="${lib.dir}/cldcapi11.jar"/>

    <!-- JDK rt.jar — needed for java.math.BigInteger used by Bouncy Castle -->
    <property name="rt.jar" value="${java.home}/lib/rt.jar"/>

    <!-- MIDlet metadata -->
    <property name="midlet.name" value="BurnerWallet"/>
    <property name="midlet.vendor" value="Guilherme Vozniak"/>
    <property name="midlet.version" value="0.1.0"/>
    <property name="midlet.class" value="org.burnerwallet.ui.BurnerWalletMIDlet"/>

    <!-- JAR size budget for Nokia C1-01 (1 MB limit) -->
    <property name="jar.size.limit" value="1048576"/>

    <!-- Register ProGuard Ant task -->
    <taskdef resource="proguard/ant/task.properties"
             classpath="${proguard.home}/lib/proguard-ant.jar"/>

    <!-- ============================================================ -->
    <target name="help" description="Show available targets">
        <echo>
Available targets:
  build      - Compile, preverify (ProGuard), and package the MIDlet
  clean      - Remove all build artifacts
  test       - Run JUnit tests on JDK 8
  size-check - Verify JAR is within device budget
  package    - Alias for build
        </echo>
    </target>

    <!-- ============================================================ -->
    <target name="clean" description="Remove build artifacts">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- ============================================================ -->
    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <!-- ============================================================ -->
    <target name="compile" depends="init" description="Compile Java sources">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="1.4"
               target="1.4"
               bootclasspath="${cldc.jar}:${midp.jar}:${rt.jar}"
               includeantruntime="false"
               debug="true">
            <classpath>
                <pathelement location="${midp.jar}"/>
                <pathelement location="${cldc.jar}"/>
                <pathelement location="${bc.jar}"/>
            </classpath>
        </javac>
    </target>

    <!-- ============================================================ -->
    <target name="unprocessed-jar" depends="compile"
            description="Package classes into unprocessed JAR for ProGuard input">
        <jar destfile="${build.dir}/${midlet.name}-unprocessed.jar"
             basedir="${classes.dir}">
            <fileset dir="${res.dir}" erroronmissingdir="false"/>
            <manifest>
                <attribute name="MIDlet-Name" value="${midlet.name}"/>
                <attribute name="MIDlet-Version" value="${midlet.version}"/>
                <attribute name="MIDlet-Vendor" value="${midlet.vendor}"/>
                <attribute name="MIDlet-1" value="${midlet.name}, , ${midlet.class}"/>
                <attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.1"/>
            </manifest>
        </jar>
    </target>

    <!-- ============================================================ -->
    <target name="preverify" depends="unprocessed-jar"
            description="Shrink and preverify with ProGuard -microedition">
        <proguard>
            -injars      ${build.dir}/${midlet.name}-unprocessed.jar
            -injars      ${bc.jar}(!META-INF/**)
            -injars      ${rt.jar}(java/math/**.class,java/util/Arrays.class)
            -outjars     ${dist.dir}/${midlet.name}-proguard.jar
            -libraryjars ${cldc.jar}
            -libraryjars ${midp.jar}
            -microedition
            -dontobfuscate
            -dontoptimize
            -allowaccessmodification
            -dontnote
            -dontwarn
            -keep public class * extends javax.microedition.midlet.MIDlet
            -keep class org.burnerwallet.** { *; }
        </proguard>
    </target>

    <!-- ============================================================ -->
    <target name="repackage" depends="preverify"
            description="Repackage java.math to cldc.math for CLDC 1.1 KVM">
        <exec executable="python3" failonerror="true">
            <arg value="${basedir}/repackage-biginteger.py"/>
            <arg value="${dist.dir}/${midlet.name}-proguard.jar"/>
            <arg value="${dist.dir}/${midlet.name}-repackaged.jar"/>
        </exec>
        <delete file="${dist.dir}/${midlet.name}-proguard.jar"/>
    </target>

    <!-- ============================================================ -->
    <!-- Re-preverify after repackaging (class renames invalidate StackMap) -->
    <target name="repreverify" depends="repackage"
            description="Re-preverify repackaged JAR for CLDC KVM">
        <proguard>
            -injars      ${dist.dir}/${midlet.name}-repackaged.jar
            -outjars     ${dist.dir}/${midlet.name}.jar
            -libraryjars ${cldc.jar}
            -libraryjars ${midp.jar}
            -microedition
            -dontshrink
            -dontoptimize
            -dontobfuscate
            -dontnote
            -dontwarn
        </proguard>
        <delete file="${dist.dir}/${midlet.name}-repackaged.jar"/>
    </target>

    <!-- ============================================================ -->
    <target name="jad" depends="repreverify" description="Generate JAD descriptor">
        <length file="${dist.dir}/${midlet.name}.jar" property="jar.size"/>
        <echo file="${dist.dir}/${midlet.name}.jad">MIDlet-Name: ${midlet.name}
MIDlet-Version: ${midlet.version}
MIDlet-Vendor: ${midlet.vendor}
MIDlet-1: ${midlet.name}, , ${midlet.class}
MIDlet-Jar-URL: ${midlet.name}.jar
MIDlet-Jar-Size: ${jar.size}
MicroEdition-Profile: MIDP-2.0
MicroEdition-Configuration: CLDC-1.1
</echo>
    </target>

    <!-- ============================================================ -->
    <target name="build" depends="jad"
            description="Full build: compile, preverify, package">
        <echo>Build complete: ${dist.dir}/${midlet.name}.jar (${jar.size} bytes)</echo>
    </target>

    <target name="package" depends="build" description="Alias for build"/>

    <!-- ============================================================ -->
    <target name="size-check" depends="preverify"
            description="Verify JAR is within device size budget">
        <length file="${dist.dir}/${midlet.name}.jar" property="jar.size"/>
        <echo>JAR size: ${jar.size} bytes (limit: ${jar.size.limit} bytes)</echo>
        <fail message="JAR exceeds size budget of ${jar.size.limit} bytes!">
            <condition>
                <length file="${dist.dir}/${midlet.name}.jar"
                        when="greater"
                        length="${jar.size.limit}"/>
            </condition>
        </fail>
        <echo>Size check PASSED.</echo>
    </target>

    <!-- ============================================================ -->
    <!-- JUnit tests — compile and run on JDK 8 (not CLDC) -->
    <target name="compile-test" depends="compile" description="Compile JUnit tests">
        <mkdir dir="${test.classes.dir}"/>
        <javac srcdir="${test.src.dir}"
               destdir="${test.classes.dir}"
               source="1.8"
               target="1.8"
               includeantruntime="false"
               debug="true">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${bc.jar}"/>
                <pathelement location="${junit.jar}"/>
                <pathelement location="${hamcrest.jar}"/>
                <pathelement location="${midp.jar}"/>
                <pathelement location="${cldc.jar}"/>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="compile-test" description="Run JUnit tests">
        <junit printsummary="on" haltonfailure="yes" fork="yes">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${test.classes.dir}"/>
                <pathelement location="${res.dir}"/>
                <pathelement location="${bc.jar}"/>
                <pathelement location="${junit.jar}"/>
                <pathelement location="${hamcrest.jar}"/>
                <pathelement location="${midp.jar}"/>
                <pathelement location="${cldc.jar}"/>
            </classpath>
            <formatter type="brief" usefile="false"/>
            <batchtest>
                <fileset dir="${test.classes.dir}" includes="**/*Test.class"/>
            </batchtest>
        </junit>
    </target>

    <!-- Checkstyle JAR — downloaded via setup-tools or manually -->
    <property name="checkstyle.jar"
              value="${basedir}/../tools/checkstyle-10.21.4-all.jar"/>

    <target name="check" depends="compile"
            description="Run Checkstyle static analysis on source files">
        <available file="${checkstyle.jar}" property="checkstyle.available"/>
        <fail unless="checkstyle.available"
              message="Checkstyle JAR not found at ${checkstyle.jar}. Run: curl -L -o tools/checkstyle-10.21.4-all.jar https://github.com/checkstyle/checkstyle/releases/download/checkstyle-10.21.4/checkstyle-10.21.4-all.jar"/>
        <taskdef resource="com/puppycrawl/tools/checkstyle/ant/checkstyle-ant-task.properties"
                 classpath="${checkstyle.jar}"/>
        <checkstyle config="${basedir}/checkstyle.xml"
                    failOnViolation="false">
            <fileset dir="${src.dir}" includes="**/*.java"/>
            <formatter type="plain"/>
        </checkstyle>
        <echo>Checkstyle analysis complete.</echo>
    </target>

    <!-- ============================================================ -->
    <!-- Dependency hash verification for supply chain integrity -->
    <target name="verify-deps"
            description="Verify SHA-256 hashes of all dependency JARs">
        <property file="${basedir}/build-hashes.properties"/>
        <echo>Verifying dependency hashes...</echo>

        <checksum file="${bc.jar}" algorithm="SHA-256"
                  property="${bcprov-jdk14.jar.sha256}" verifyproperty="bc.ok"/>
        <fail message="bcprov-jdk14.jar hash mismatch!">
            <condition><isfalse value="${bc.ok}"/></condition>
        </fail>

        <checksum file="${cldc.jar}" algorithm="SHA-256"
                  property="${cldcapi11.jar.sha256}" verifyproperty="cldc.ok"/>
        <fail message="cldcapi11.jar hash mismatch!">
            <condition><isfalse value="${cldc.ok}"/></condition>
        </fail>

        <checksum file="${midp.jar}" algorithm="SHA-256"
                  property="${midpapi20.jar.sha256}" verifyproperty="midp.ok"/>
        <fail message="midpapi20.jar hash mismatch!">
            <condition><isfalse value="${midp.ok}"/></condition>
        </fail>

        <echo>All dependency hashes verified.</echo>
    </target>

    <!-- ============================================================ -->
    <!-- Reproducible build: verify deps, build, and hash output -->
    <target name="reproducible-build" depends="verify-deps,clean,build"
            description="Build with dependency verification and output hash">
        <checksum file="${dist.dir}/${midlet.name}.jar"
                  algorithm="SHA-256" property="output.sha256"/>
        <echo>Output JAR SHA-256: ${output.sha256}</echo>
        <echo file="${dist.dir}/${midlet.name}.jar.sha256"
              message="${output.sha256}  ${midlet.name}.jar${line.separator}"/>
        <echo>Hash saved to ${dist.dir}/${midlet.name}.jar.sha256</echo>
    </target>
</project>
